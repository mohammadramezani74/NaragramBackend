<?xml version="1.0" encoding="utf-8"?>
<!--
  تنظیم IIS برای بک‌اند ناراگرام. قبلاً این فایل در ریپو نبود و هر publish یک web.config
  پیش‌فرض می‌ساخت که سقف درخواست IIS را روی ۳۰ مگابایت می‌گذاشت؛ فایل بزرگ‌تر قبل از
  رسیدن به برنامه رد می‌شد و کاربر فقط «۰٪» و بعد خطا می‌دید.
  maxAllowedContentLength باید با MaxUpload در Program.cs یکی باشد (۵۵۰ مگابایت).
  publish خودش processPath و arguments را درست می‌کند.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CleanArchitecture.Presentation.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="576716800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
